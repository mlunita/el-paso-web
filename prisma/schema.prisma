generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  password       String
  name           String?
  role           String         @default("ADMIN")
  posts          Post[]
  supportEntries SupportEntry[] @relation("SupportEntryAuthor")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Post {
  id         String   @id @default(cuid())
  title      String
  content    String
  coverImage String?
  published  Boolean  @default(false)
  authorName String?
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Application {
  id        String   @id @default(cuid())
  refCode   String   @unique
  discord   String
  roblox    String
  message   String
  links     String?
  status    String   @default("PENDING") // PENDING, REVIEWED, APPROVED, REJECTED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  image     String?
  discordId String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id             String   @id @default(cuid())
  bannerImage    String?
  bannerTitle    String   @default("Welcome to Our Community")
  bannerSubtitle String   @default("Your adventure starts here")
  description    String   @default("Join us to explore new worlds, make friends, and have fun.")
  socialDiscord  String?
  socialTwitter  String?
  socialYoutube  String?
  appsOpen       Boolean  @default(true)
  ticketStatus   String   @default("GREEN") // GREEN, YELLOW, ORANGE, RED
  updatedAt      DateTime @updatedAt
}

model WikiItem {
  id           String   @id @default(cuid())
  title        String
  description  String
  section      String // GAMEPASS, WEAPONS, EQUIPMENT, CARS, TEAMS
  image        String?
  order        Int      @default(0)
  tags         String? // JSON array of tag strings, e.g. '["Rare","VIP"]'
  customFields String? // JSON object for section-specific fields, e.g. '{"mileage":"50k"}'
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SupportCategory {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  visibility  String         @default("PUBLIC") // PUBLIC, HIDDEN
  order       Int            @default(0)
  entries     SupportEntry[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([visibility, order])
}

model SupportEntry {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  content     String
  status      String          @default("DRAFT") // DRAFT, PUBLISHED
  visibility  String          @default("PUBLIC") // PUBLIC, UNLISTED, HIDDEN
  order       Int             @default(0)
  featured    Boolean         @default(false)
  publishedAt DateTime?
  authorName  String?
  authorId    String?
  author      User?           @relation("SupportEntryAuthor", fields: [authorId], references: [id])
  categoryId  String
  category    SupportCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, visibility, publishedAt])
  @@index([categoryId, order, createdAt])
}

// =====================================================
// Role-Based Moderation System
// =====================================================

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions Permission[]
  tokens      ModeratorToken[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique // machine key: "view_mod_panel", "create_ban_requests", etc.
  label String // human label: "View Mod Panel"
  roles Role[]
}

model ModeratorToken {
  id            String              @id @default(cuid())
  tokenHash     String              @unique
  tokenPreview  String // last 6 chars for display, e.g. "…a3f2b1"
  moderatorName String
  moderatorId   String // admin-assigned external identifier
  roleId        String
  role          Role                @relation(fields: [roleId], references: [id])
  status        String              @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  permSnapshot  String? // JSON snapshot of permissions at creation time
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  expiresAt     DateTime?
  loginLogs     ModeratorLoginLog[]
  banRequests   BanRequest[]
  shifts        ModShift[]           @relation("ShiftToken")
  modActions    ModAction[]          @relation("ActionToken")
}

model ModeratorLoginLog {
  id        String         @id @default(cuid())
  tokenId   String
  token     ModeratorToken @relation(fields: [tokenId], references: [id])
  ipAddress String?
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime       @default(now())
}

model BanRequest {
  id             String               @id @default(cuid())
  tokenId        String
  token          ModeratorToken       @relation(fields: [tokenId], references: [id])
  modName        String
  modId          String
  modRole        String
  modPermissions String?
  targetUserId   String
  targetUsername String
  reason         String
  notes          String?
  status         String               @default("PENDING")
  adminNotes     String?
  reviewedBy     String?
  reviewedAt     DateTime?
  evidence       BanRequestEvidence[]
  auditLogs      BanRequestAuditLog[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model BanRequestEvidence {
  id           String     @id @default(cuid())
  banRequestId String
  banRequest   BanRequest @relation(fields: [banRequestId], references: [id], onDelete: Cascade)
  type         String // "IMAGE" or "VIDEO"
  url          String
  caption      String?
  createdAt    DateTime   @default(now())
}

model BanRequestAuditLog {
  id           String     @id @default(cuid())
  banRequestId String
  banRequest   BanRequest @relation(fields: [banRequestId], references: [id], onDelete: Cascade)
  action       String // "CREATED", "STATUS_CHANGED", "NOTE_ADDED", "REVIEWED"
  fromStatus   String?
  toStatus     String?
  performedBy  String // "mod:<modId>" or "admin"
  details      String?
  createdAt    DateTime   @default(now())
}

// =====================================================
// Admin Token-Based Authentication
// =====================================================

model AdminToken {
  id         String          @id @default(cuid())
  publicId   String          @unique // first half of token for O(1) lookup
  name       String // human-readable label, e.g. "Main Admin"
  tokenHash  String // bcrypt hash of the secret half
  notes      String?
  createdBy  String? // who ran the script, e.g. "cli:root"
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  lastUsedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime?
  auditLogs  AdminAuditLog[]
}

model AdminAuditLog {
  id        String     @id @default(cuid())
  tokenId   String
  token     AdminToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  action    String // "LOGIN", "LOGIN_FAILED", "TOKEN_REVOKED", "TOKEN_REACTIVATED"
  ipAddress String?
  userAgent String?
  createdAt DateTime   @default(now())
}

// =====================================================
// First-Party Analytics
// =====================================================

model AnalyticsVisitor {
  id          String              @id @default(cuid())
  clientId    String              @unique
  country     String?
  region      String?
  city        String?
  timezone    String?
  language    String?
  deviceType  String?
  browser     String?
  os          String?
  firstSeenAt DateTime            @default(now())
  lastSeenAt  DateTime            @default(now())
  sessions    AnalyticsSession[]
  pageViews   AnalyticsPageView[]
  events      AnalyticsEvent[]
  webVitals   AnalyticsWebVital[]

  @@index([firstSeenAt])
  @@index([lastSeenAt])
  @@index([country])
  @@index([deviceType])
}

model AnalyticsSession {
  id              String              @id @default(cuid())
  sessionId       String              @unique
  visitorId       String
  visitor         AnalyticsVisitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  startedAt       DateTime            @default(now())
  lastSeenAt      DateTime            @default(now())
  durationSeconds Int                 @default(0)
  entryPath       String?
  exitPath        String?
  referrer        String?
  source          String              @default("direct")
  medium          String              @default("none")
  campaign        String?
  country         String?
  region          String?
  city            String?
  deviceType      String?
  browser         String?
  os              String?
  language        String?
  timezone        String?
  pageViews       AnalyticsPageView[]
  events          AnalyticsEvent[]
  webVitals       AnalyticsWebVital[]

  @@index([startedAt])
  @@index([lastSeenAt])
  @@index([source, medium])
  @@index([country])
  @@index([deviceType])
}

model AnalyticsPageView {
  id             String           @id @default(cuid())
  visitorId      String
  visitor        AnalyticsVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  sessionId      String
  session        AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  path           String
  title          String?
  referrer       String?
  country        String?
  region         String?
  city           String?
  deviceType     String?
  browser        String?
  os             String?
  language       String?
  timezone       String?
  viewportWidth  Int?
  viewportHeight Int?
  createdAt      DateTime         @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([country, createdAt])
  @@index([deviceType, createdAt])
  @@index([visitorId, createdAt])
  @@index([sessionId, createdAt])
}

model AnalyticsEvent {
  id        String            @id @default(cuid())
  visitorId String?
  visitor   AnalyticsVisitor? @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  sessionId String?
  session   AnalyticsSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  category  String?
  path      String?
  label     String?
  value     Float?
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([category, createdAt])
  @@index([path, createdAt])
}

model AnalyticsWebVital {
  id             String            @id @default(cuid())
  visitorId      String?
  visitor        AnalyticsVisitor? @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  sessionId      String?
  session        AnalyticsSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  metricId       String?
  name           String
  value          Float
  delta          Float?
  rating         String?
  navigationType String?
  path           String?
  createdAt      DateTime          @default(now())

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([rating, createdAt])
  @@index([path, createdAt])
}

// =====================================================
// Shift Management System
// =====================================================

model ModShift {
  id            String          @id @default(cuid())
  tokenId       String
  token         ModeratorToken  @relation("ShiftToken", fields: [tokenId], references: [id])
  modName       String
  modId         String
  modRole       String
  shiftType     String          @default("REGULAR") // REGULAR, TRAINING, EVENT, EMERGENCY, OVERTIME
  status        String          @default("ACTIVE")   // ACTIVE, PAUSED, COMPLETED, CANCELLED, EDITED
  clockIn       DateTime        @default(now())
  clockOut      DateTime?
  totalSeconds  Int             @default(0)
  breakSeconds  Int             @default(0)
  notes         String?
  adminNotes    String?
  editedBy      String?         // "admin" or null
  editedAt      DateTime?
  breaks        ModShiftBreak[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([tokenId, status])
  @@index([modId, clockIn])
  @@index([status, clockIn])
  @@index([clockIn])
}

model ModShiftBreak {
  id         String   @id @default(cuid())
  shiftId    String
  shift      ModShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  startedAt  DateTime @default(now())
  endedAt    DateTime?
  duration   Int      @default(0) // seconds
  reason     String?
  createdAt  DateTime @default(now())

  @@index([shiftId])
}

// =====================================================
// Manual Moderation Action Registry
// =====================================================

model ModAction {
  id               String              @id @default(cuid())
  tokenId          String
  token            ModeratorToken      @relation("ActionToken", fields: [tokenId], references: [id])
  modName          String
  modId            String
  modRole          String
  actionType       String              // BAN_REQUEST, MODLOG, TICKET, CHEATER_BAN, WARNING, KICK, APPEAL_REVIEW, STAFF_NOTE, CASE_REVIEW, INTERNAL_ESCALATION, CUSTOM
  preset           String?             // matches actionType or custom label
  targetUser       String?             // Roblox username or ID
  reason           String
  evidenceLink     String              // link to message, log, ticket, etc.
  internalNotes    String?
  reviewStatus     String              @default("UNREVIEWED") // UNREVIEWED, REVIEWED, FLAGGED, REJECTED
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNotes      String?
  deletedAt        DateTime?           // soft delete
  deletedBy        String?
  auditLogs        ModActionAuditLog[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([tokenId, createdAt])
  @@index([modId, createdAt])
  @@index([actionType, createdAt])
  @@index([reviewStatus, createdAt])
  @@index([targetUser, createdAt])
  @@index([createdAt])
}

model ModActionAuditLog {
  id          String    @id @default(cuid())
  actionId    String
  action      ModAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  event       String    // CREATED, EDITED, DELETED, REVIEW_CHANGED, RESTORED
  performedBy String    // "mod:<modId>" or "admin"
  fromValue   String?
  toValue     String?
  details     String?
  createdAt   DateTime  @default(now())

  @@index([actionId, createdAt])
}

// =====================================================
// Roblox User Lookup System
// =====================================================

model RobloxLookupLog {
  id           String   @id @default(cuid())
  performedBy  String   // "mod:<modId>" or "admin"
  performerName String
  query        String   // username or userId searched
  resultUserId String?  // resolved userId
  resultName   String?  // resolved username
  success      Boolean
  createdAt    DateTime @default(now())

  @@index([performedBy, createdAt])
  @@index([resultUserId, createdAt])
  @@index([createdAt])
}

model RobloxUserCache {
  id              String   @id @default(cuid())
  robloxUserId    String   @unique
  username        String
  displayName     String?
  description     String?
  avatarUrl       String?
  accountCreated  DateTime?
  isBanned        Boolean  @default(false)
  lastFetched     DateTime @default(now())
  rawData         String?  // JSON blob for extra data
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([username])
  @@index([lastFetched])
}
